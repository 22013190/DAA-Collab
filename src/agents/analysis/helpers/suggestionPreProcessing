### 3️⃣  Extend `fastmcp_server.py`

Add these two tools at the top of the file to fill your preprocessing gaps.

```python
@tool
def validate_csv(file_path: str) -> dict:
    """Check file readability and delimiter."""
    import csv
    issues = []
    try:
        with open(file_path, "r", encoding="utf-8", errors="replace") as f:
            sample = f.read(10000)
        csv.Sniffer().sniff(sample)
    except Exception as e:
        issues.append(str(e))
    return {"status": "ok", "issues": issues}

@tool
def infer_schema(file_path: str) -> dict:
    """Infer column types and sample statistics."""
    import pandas as pd
    df = pd.read_csv(file_path, nrows=5000)
    schema = {col: str(df[col].dtype) for col in df.columns}
    stats = df.describe(include="all").to_dict()
    return {"schema": schema, "stats": stats}
```

You already have these tools:
`handle_missing_values`, `handle_outliers`, `expand_json_columns`, and `summarize_dataset`.
Keep using them as-is.

