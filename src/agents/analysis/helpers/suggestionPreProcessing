### 1️⃣  Create new file: `preprocess_node.py`
Implements the PreprocessNode that runs before ReasoningNode.

```python
# preprocess_node.py
from pydantic import BaseModel
from langgraph.types import Node
from fastmcp_client import FastMCPClient  # adjust import path if needed

class PreparedDataset(BaseModel):
    cleaned_path: str
    schema_summary: dict
    preprocessing_report: str
    issues_detected: list[str]
    fixes_applied: list[str]

class PreprocessNode(Node):
    def __init__(self, fastmcp: FastMCPClient):
        self.fastmcp = fastmcp

    def run(self, state):
        csv_path = state.get("dataset_path")
        issues, fixes = [], []

        # 1. Validate CSV
        validate = self.fastmcp.call_tool("validate_csv", {"file_path": csv_path})
        issues.extend(validate.get("issues", []))

        # 2. Infer schema
        schema = self.fastmcp.call_tool("infer_schema", {"file_path": csv_path})

        # 3. Handle missing values
        cleaned = self.fastmcp.call_tool("handle_missing_values", {"file_path": csv_path})
        fixes.append("handled_missing_values")

        # 4. Handle outliers
        outliers = self.fastmcp.call_tool("handle_outliers", {"file_path": cleaned["output_path"]})
        fixes.append("handled_outliers")

        # 5. Expand JSON columns
        expanded = self.fastmcp.call_tool("expand_json_columns", {"file_path": outliers["output_path"]})
        fixes.append("expanded_json_columns")

        # 6. Summarize dataset
        summary = self.fastmcp.call_tool("summarize_dataset", {"file_path": expanded["output_path"]})

        prepared = PreparedDataset(
            cleaned_path=expanded["output_path"],
            schema_summary=schema,
            preprocessing_report=summary["summary"],
            issues_detected=issues,
            fixes_applied=fixes,
        )

        # update graph state
        state["prepared_dataset"] = prepared.dict()
        state["dataset_path"] = prepared.cleaned_path
        state["dataset_schema"] = prepared.schema_summary
        return state
````

